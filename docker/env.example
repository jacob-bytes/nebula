# 星云盘 Docker 部署环境变量示例
#
#   cp docker/env.example .env
#
# 只有标注「必填」的两项是启动硬性要求；其余留空即不启用对应能力。

# --- 必填 -------------------------------------------------------------------
# JWT 签名密钥：至少 32 字符且不得是占位值/低熵值（启动时会校验并拒绝）
JWT_SECRET=请用 openssl rand -hex 32 生成后粘贴到这里
# PostgreSQL 密码（compose 内部使用，不会暴露到宿主机）
POSTGRES_PASSWORD=请设置一个强密码

# --- 建议设置 ---------------------------------------------------------------
# 数据库
POSTGRES_DB=nebula
POSTGRES_USER=nebula
# 对外访问地址：分享链接、邮件中的绝对地址由它拼出
APP_URL=http://localhost:3000
# 允许的跨域来源；与 APP_URL 同源时填同样的值
CORS_ORIGINS=http://localhost:3000
# 宿主机映射端口（默认 3000，仅绑定 127.0.0.1）
APP_PORT_HOST=3000

# --- Telegram 文件存储 ------------------------------------------------------
# 不填则无法上传/下载文件，站点只剩账号与配置功能
TELEGRAM_BOT_TOKEN=
# 用作存储仓库的群/频道 chat_id（形如 -1001234567890）
TELEGRAM_CHAT_ID=
# 自建 Bot API 地址（可选），例如 http://bot-api:8081
TELEGRAM_API_BASE=
# 自建 Bot API 的本地文件目录（可选），例如 /var/lib/telegram-bot-api
TELEGRAM_LOCAL_FILE_DIR=

# --- 邮件（可选）------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 本地 Telegram Bot API（可选，启用 botapi profile 时才需要）---------------
# 突破官方 20MB 下载上限。API_ID/API_HASH 来自 my.telegram.org（**不是** Bot Token）。
# 启用后把下面两项一并填上，并让两个容器共享同一个 workdir 路径。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE=
TELEGRAM_LOCAL_FILE_DIR=

# --- 其他 -------------------------------------------------------------------
# 验证码 HMAC 密钥；留空则回退使用 JWT_SECRET
CODE_HMAC_SECRET=
LOG_LEVEL=info
